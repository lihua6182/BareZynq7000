{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Convert Bitstream",
            "detail": "将比特流打包为 ZBLZ 压缩 C 数组",
            "type": "shell",
            "command": "py \"tools/convert_bitstream.py\" \"${input:bitstreamBin}\" \"source/board/board_pl_bitstream.c\" \"source/board/board_pl_bitstream.h\"",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Flash QSPI",
            "type": "shell",
            "command": "py \"tools/flash_qspi.py\" \"${input:flashHex}\"",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "bitstreamBin",
            "type": "promptString",
            "description": "输入比特流",
            "default": "source/board/bitstream.bin"
        },
        {
            "id": "flashHex",
            "type": "pickString",
            "description": "选择要烧写的镜像",
            "options": [
                "build/release/source/app/app.hex",
                "build/debug/source/app/app.hex",
                "build/release/source/example/usb_cdc_speed_test/usb_cdc_speed_test.hex",
                "build/debug/source/example/usb_cdc_speed_test/usb_cdc_speed_test.hex"
            ],
            "default": "build/release/source/app/app.hex"
        }
    ]
}